# Device Configuration
-a "iCE40UP"
-p iCE40UP5K
-t SG48
-sp "High-Performance_1.2V"

# Synthesis Strategy Options
-frequency 200
-optimization_goal Area
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-max_fanout 1000
-fsm_encoding_style Auto
-fix_gated_clocks 1
-loop_limit 1950
-use_io_reg auto
-drc_cfg 35103300 20
-use_io_insertion 1
-resolve_mixed_drivers 0

# Constraint Files
-sdc "Lab3_impl_1_cpe.ldc"

# Search Paths
-path "C:/lscc/radiant/2026.1/ispfpga/ice40tp/data"
-path "."
-path ".."
-path "../source/impl_1"

# PMI Library Files
-ver "C:/lscc/radiant/2026.1/ip/pmi/pmi_iCE40UP.v"
-lib pmi -vhd "C:/lscc/radiant/2026.1/ip/pmi/pmi_iCE40UP.vhd"

# Source Files
-sver "../source/impl_1/lab3_ta.sv"
-sver "../source/impl_1/lab1_ta_hex_seg_decoder.sv"
-sver "../source/impl_1/lab2_ta_counter.sv"
-sver "../source/impl_1/lab3_ta_scanner.sv"
-sver "../source/impl_1/lab3_ta_sync.sv"
-sver "../source/impl_1/lab3_ta_keypad_decoder.sv"
-sver "../source/impl_1/lab3_ta_keypad_builder.sv"
-sver "../source/impl_1/lab3_ta_digit_sr.sv"
-sver "../source/impl_1/lab3_ta_controller.sv"
-sver "../source/impl_1/lab3_ta_scanner_tb.sv"
-sver "../source/impl_1/lab3_ta_sync_tb.sv"
-sver "../source/impl_1/lab3_ta_digit_sr_tb.sv"
-sver "../source/impl_1/lab3_ta_keypad_builder_tb.sv"
-sver "../source/impl_1/lab3_ta_keypad_decoder_tb.sv"
-sver "../source/impl_1/lab3_ta_savedkey_sr.sv"
-sver "../source/impl_1/lab3_ta_savedkey_sr_tb.sv"
-path ".."
-top lab3_ta
# Output Configuration
-udb "Lab3_impl_1_rtl.udb"
-output_hdl "Lab3_impl_1.vm"
